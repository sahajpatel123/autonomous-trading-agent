# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket — Polygon wallet credentials
POLYMARKET_PRIVATE_KEY=0x...        # Private key of your Polygon EOA wallet
POLYMARKET_ADDRESS=0x...            # Public address of that wallet (same as private key owner)

# Trading behaviour (all optional — defaults shown)
TRADING_INTERVAL_SECONDS=1800       # How often the loop runs (seconds). Default: 30 min
MAX_MARKETS_TO_ANALYZE=20           # How many markets Claude sees per cycle
CLAUDE_MODEL=claude-sonnet-4-20250514

# Risk controls (all optional — defaults shown)
MAX_POSITION_SIZE_USD=5.0           # Hard cap per single trade
MAX_DAILY_LOSS_USD=10.0             # Stop trading for the day once this is lost
MIN_CONFIDENCE_THRESHOLD=0.7        # Claude must be >= this confident to execute
MAX_POSITION_FRACTION=0.30          # Max fraction of available cash per trade
MIN_CASH_FLOOR=4.0                  # Never trade if it would drop cash below this

# Persistence
STATE_FILE=state.json               # Portfolio state (survives restarts)
TRADE_LOG_FILE=trades.jsonl         # Append-only decision + execution log
