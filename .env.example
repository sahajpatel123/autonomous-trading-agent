# Claude API
ANTHROPIC_API_KEY=

# Polymarket — Polygon wallet credentials
POLYMARKET_PRIVATE_KEY=
POLYMARKET_ADDRESS=
POLYMARKET_PROXY_ADDRESS=

# Trading behaviour (all optional — defaults shown)
TRADING_INTERVAL_SECONDS=1800
MAX_MARKETS_TO_ANALYZE=20
CLAUDE_MODEL=claude-sonnet-4-20250514

# Risk controls (all optional — defaults shown)
MAX_POSITION_SIZE_USD=5.0
MAX_DAILY_LOSS_USD=10.0
MIN_CONFIDENCE_THRESHOLD=0.7
MAX_POSITION_FRACTION=0.30
MIN_CASH_FLOOR=4.0

# Persistence
STATE_FILE=state.json
TRADE_LOG_FILE=trades.jsonl
